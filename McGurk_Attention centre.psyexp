                <Param name="opacity" val="1 if int(nLs) &gt; 0 else 0" valType="num" updates="set every repeat" plugin="None"/>
                <Param name="pos" val="(random()*700 - 350, random()*500 - 250)" valType="list" updates="set every repeat" plugin="None"/>
